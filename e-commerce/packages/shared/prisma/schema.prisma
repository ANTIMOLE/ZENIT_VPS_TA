// ============================================================
// schema.prisma — E-Commerce System
// Research: tRPC vs REST API Performance Comparison
// Database: PostgreSQL 15
//
// FIX:
//  - Tambah composite indexes untuk query dominan di getAll()
//  - Tambah GIN index untuk full-text search (name)
//  - Pisah composite index per pola akses (isActive+category, isActive+price, dsb.)
//  - FIX: RefreshToken ganti @@index([userId]) + @@index([tokenHash]) yang salah
//         ? @@index([userId, revoked]) composite, sesuai query aktual auth.service
//  - FIX: Order tambah @@index([userId, createdAt(sort: Desc)]) untuk getOrders()
// ============================================================

generator client {
  provider        = "prisma-client-js"
  output          = "../generated/prisma"
  previewFeatures = ["fullTextSearchPostgres"]
}

datasource db {
  provider = "postgresql"
  //url      = env("DATABASE_URL")
}

// ============================================================
// USER & AUTH
// ============================================================

enum UserRole {
  USER
  ADMIN
}

model User {
  id           String   @id @default(uuid())
  name         String   @db.VarChar(100)
  email        String   @unique @db.VarChar(255)
  passwordHash String   @map("password_hash") @db.VarChar(255)
  phone        String?  @db.VarChar(20)
  role         UserRole @default(USER)
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  refreshTokens RefreshToken[]
  cart          Cart?
  orders        Order[]
  addresses     Address[]

  @@index([role])
  @@map("users")
}

model RefreshToken {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  tokenHash String   @map("token_hash") @db.VarChar(255)
  expiresAt DateTime @map("expires_at")
  revoked   Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  // FIX: ganti @@index([userId]) + @@index([tokenHash]) yang tidak tepat.
  //
  // Query aktual di auth.service (semua operasi refresh/login/logout/changePassword):
  //   WHERE user_id = ? AND revoked = false
  //
  // Composite @@index([userId, revoked]) covers query ini dengan perfect index scan.
  // Leftmost-prefix rule: juga covers query WHERE user_id = ? saja (kalau ada).
  //
  // @@index([tokenHash]) dihapus karena tidak ada satu pun query yang filter by tokenHash.
  // tokenHash hanya dipakai untuk bcrypt.compare() setelah data sudah di-fetch by userId.
  // Index yang tidak pernah dipakai hanya buang storage + memperlambat INSERT.
  @@index([userId, revoked])
  @@map("refresh_tokens")
}

// ============================================================
// PRODUCT & CATEGORY
// ============================================================

model Category {
  id          String   @id @default(uuid())
  name        String   @unique @db.VarChar(100)
  slug        String   @unique @db.VarChar(120)
  description String?  @db.Text
  createdAt   DateTime @default(now()) @map("created_at")

  products Product[]

  @@map("categories")
}

model Product {
  id          String   @id @default(uuid())
  categoryId  String   @map("category_id")
  name        String   @db.VarChar(500)
  slug        String   @unique @db.VarChar(550)
  description String?  @db.Text
  price       Decimal  @db.Decimal(12, 2)
  stock       Int      @default(0)
  images      String[] @default([])
  rating      Decimal? @db.Decimal(3, 2)
  soldCount   Int      @default(0) @map("sold_count")
  location    String?  @db.VarChar(200)
  discount    Int?     @default(0)
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  category   Category    @relation(fields: [categoryId], references: [id])
  cartItems  CartItem[]
  orderItems OrderItem[]

  // -- Single-column indexes ----------------------------------
  @@index([categoryId])
  @@index([isActive])

  // -- Composite indexes --------------------------------------
  // WHERE isActive=true ORDER BY createdAt DESC  ? default sort
  @@index([isActive, createdAt(sort: Desc)])

  // WHERE isActive=true AND categoryId=? ORDER BY createdAt DESC
  @@index([isActive, categoryId, createdAt(sort: Desc)])

  // WHERE isActive=true ORDER BY price ASC/DESC
  @@index([isActive, price])

  // WHERE isActive=true ORDER BY rating DESC
  @@index([isActive, rating])

  // WHERE isActive=true ORDER BY soldCount DESC
  @@index([isActive, soldCount])

  // -- Full-text search index ---------------------------------
  // GIN index untuk to_tsvector TIDAK bisa didefinisikan di Prisma schema DSL.
  // Harus dibuat manual via migration SQL — lihat:
  //   migrations/YYYYMMDDHHMMSS_add_fts_index/migration.sql
  //
  // CREATE INDEX "idx_products_name_fts"
  // ON "products" USING GIN (to_tsvector('english', "name"));

  @@map("products")
}

// ============================================================
// CART
// ============================================================

enum CartStatus {
  active
  checked_out
  abandoned
}

model Cart {
  id        String     @id @default(uuid())
  userId    String     @unique @map("user_id")
  status    CartStatus @default(active)
  createdAt DateTime   @default(now()) @map("created_at")
  updatedAt DateTime   @updatedAt @map("updated_at")

  user  User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  items CartItem[]

  @@map("carts")
}

model CartItem {
  id          String   @id @default(uuid())
  cartId      String   @map("cart_id")
  productId   String   @map("product_id")
  quantity    Int      @default(1)
  priceAtTime Decimal  @map("price_at_time") @db.Decimal(12, 2)
  createdAt   DateTime @default(now()) @map("created_at")

  cart    Cart    @relation(fields: [cartId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])

  @@unique([cartId, productId])
  @@index([cartId])
  @@index([productId])
  @@map("cart_items")
}

// ============================================================
// ADDRESS
// ============================================================

model Address {
  id            String   @id @default(uuid())
  userId        String   @map("user_id")
  label         String?  @db.VarChar(50)
  recipientName String   @map("recipient_name") @db.VarChar(100)
  phone         String   @db.VarChar(20)
  address       String   @db.Text
  city          String   @db.VarChar(100)
  province      String   @db.VarChar(100)
  zipCode       String   @map("zip_code") @db.VarChar(10)
  isDefault     Boolean  @default(false) @map("is_default")
  createdAt     DateTime @default(now()) @map("created_at")

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  orders Order[]

  @@index([userId])
  @@map("addresses")
}

// ============================================================
// ORDER
// ============================================================

enum OrderStatus {
  pending_payment
  confirmed
  processing
  shipped
  delivered
  cancelled
}

enum PaymentMethod {
  bank_transfer
  qris
  cod
}

enum ShippingMethod {
  regular
  express
}

model Order {
  id              String         @id @default(uuid())
  userId          String         @map("user_id")
  addressId       String?        @map("address_id")
  orderNumber     String         @unique @map("order_number") @db.VarChar(30)
  status          OrderStatus    @default(pending_payment)
  subtotal        Decimal        @db.Decimal(14, 2)
  tax             Decimal        @db.Decimal(14, 2)
  shippingCost    Decimal        @map("shipping_cost") @db.Decimal(14, 2)
  total           Decimal        @db.Decimal(14, 2)
  shippingAddress Json           @map("shipping_address")
  paymentMethod   PaymentMethod  @map("payment_method")
  shippingMethod  ShippingMethod @map("shipping_method")
  createdAt       DateTime       @default(now()) @map("created_at")
  updatedAt       DateTime       @updatedAt @map("updated_at")

  user    User        @relation(fields: [userId], references: [id])
  address Address?    @relation(fields: [addressId], references: [id])
  items   OrderItem[]

  // Single-column (dipakai admin: filter by status, search by orderNumber)
  @@index([orderNumber])
  @@index([status])
  @@index([createdAt])

  // FIX: tambah composite untuk query dominan getOrders(userId):
  //   WHERE user_id = ? ORDER BY created_at DESC
  // Sebelumnya: @@index([userId]) terpisah + @@index([createdAt]) terpisah
  // ? PostgreSQL harus bitmap merge dua index, lebih lambat.
  // Composite (userId, createdAt DESC) = single index scan yang covers filter + sort.
  @@index([userId, createdAt(sort: Desc)])

  @@map("orders")
}

model OrderItem {
  id           String  @id @default(uuid())
  orderId      String  @map("order_id")
  productId    String? @map("product_id")
  productName  String  @map("product_name") @db.VarChar(500)
  productImage String? @map("product_image") @db.VarChar(1000)
  quantity     Int
  unitPrice    Decimal @map("unit_price") @db.Decimal(12, 2)
  subtotal     Decimal @db.Decimal(14, 2)

  order   Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@map("order_items")
}
